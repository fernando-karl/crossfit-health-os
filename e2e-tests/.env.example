# CrossFit Health OS - E2E Test Configuration
# Copy this file to .env and fill in your values

# Base URL of the application
# Local systemd deploy: http://127.0.0.1:8003
# Docker / uvicorn dev: http://localhost:8000
BASE_URL=http://127.0.0.1:8003

# API Base URL
API_BASE_URL=http://127.0.0.1:8003/api/v1

# Test user credentials (reuse to avoid register rate limits)
TEST_EMAIL=
TEST_PASSWORD=

# Admin user for specific tests
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPass123

# Browser configuration
# BROWSER=chromium

# Test configuration
HEADED=false
TIMEOUT=30000

# Debug options
DEBUG=false
TRACE=false
SCREENSHOT=true
