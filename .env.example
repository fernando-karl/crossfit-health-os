# Application
APP_NAME=CrossFit Health OS
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars

# URLs
APP_DOMAIN=localhost
APP_SCHEME=http
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000

# Database (Alembic schema — use `alembic upgrade head` after first boot)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/crossfit

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_TTL_DAYS=30

# AI (at least one recommended)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google Calendar (optional)
GOOGLE_CALENDAR_CLIENT_ID=your-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret

# Stripe billing (optional — endpoints return 501 until configured)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Internal cron (weekly reviews — required for automated reviews in prod)
INTERNAL_CRON_SECRET=change-me-to-a-long-random-string

# SMTP (optional — sends password-reset emails; logs link when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Legal / support
SUPPORT_EMAIL=support@example.com
DPO_EMAIL=dpo@example.com
DEFAULT_TIMEZONE=America/Sao_Paulo

# Legacy (unused — kept for backward compatibility)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
APPLE_TEAM_ID=
TODOIST_API_TOKEN=
